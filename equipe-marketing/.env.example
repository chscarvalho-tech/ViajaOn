# Copie para ".env" antes de rodar. Nenhuma chave aqui é obrigatória pra testar o pipeline —
# sem elas, os passos correspondentes caem em modo demo/fallback (ver comentários nos scripts).

# Pesquisa de mercado real via Tavily (https://tavily.com). Sem isso, scripts/research.js
# roda em modo demo (output com a mesma estrutura, marcado "fonte: demo").
TAVILY_API_KEY=

# Hosting de mídia real via Supabase Storage. Sem isso, scripts/distribute.js usa caminho de
# arquivo local como "URL" (fallback, avisado no console e no Publish MD).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=campaign-uploads

# Caminho pro Chrome, se não estiver num dos locais padrão que scripts/lib/chrome.js já procura.
CHROME_PATH=

# Caminho pro ffmpeg, se não estiver no PATH (ex.: instalado fora do padrão do winget).
FFMPEG_PATH=
