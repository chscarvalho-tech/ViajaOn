# Copie este arquivo para ".env" e preencha antes de rodar qualquer comando de envio.
# Nada aqui é lido automaticamente até existir um ".env" real (que fica fora do git).

# Link da agenda para marcar a call de 30 minutos (Calendly, Google Calendar etc.) — obrigatório,
# é o CTA de toda mensagem de abordagem e follow-up. Sem isso a maioria dos scripts falha ao
# renderizar (ver src/content/render.js: variável não preenchida derruba o envio).
AGENDA_LINK=

# Fuso horário usado para calcular horário comercial / horário de silêncio
TIMEZONE=America/Sao_Paulo

# Horário limite de envio no dia de hoje, formato HH:mm (24h). Deixe em branco para usar
# o horário comercial padrão (09:00–19:00) definido em src/config.js.
TODAY_CUTOFF=

# Caminho para o Chrome/Chromium com a sessão do LinkedIn já logada, se quiser reaproveitar
# um perfil existente em vez de logar do zero pelo Playwright. Deixe em branco para usar
# o perfil dedicado que o script cria em data/state/linkedin-profile.
LINKEDIN_CHROME_PROFILE_DIR=
