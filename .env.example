# --- IA (escolha o provedor em config/bot.json → provedor_ia) ---
# provedor_ia = "anthropic": chave da API do Claude
ANTHROPIC_API_KEY=
# provedor_ia = "omniroute": gateway OmniRoute (compatível com OpenAI). Chave em Dashboard → Endpoints, se exigida
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# --- WA-AKG (gateway de WhatsApp) ---
# URL base do WA-AKG, sem /api no final
WAAKG_URL=http://localhost:3000
# Dashboard do WA-AKG > Settings > API Keys (formato wag_...)
WAAKG_API_KEY=
# ID da sessão do WhatsApp conectada no WA-AKG (ex.: session-01)
WAAKG_SESSION=

# Segredo HMAC compartilhado com o webhook do WA-AKG (gerado pelo instalador)
WEBHOOK_SECRET=

# --- Este servidor ---
PORT=3100
# URL em que o WA-AKG e o seu time alcançam este servidor (usada no webhook e nos links do painel)
PUBLIC_URL=http://localhost:3100
# Senha de acesso ao painel de gestão
PAINEL_SENHA=
